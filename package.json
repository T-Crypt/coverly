{
  "name": "coverly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Add or replace the cover of an EPUB. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "python3 test/gen_samples.py && node --test test/",
    "test:e2e": "node test/e2e.mjs",
    "gen:samples": "python3 test/gen_samples.py",
    "gen:icons": "bash scripts/gen_icons.sh"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.5",
    "@fontsource/quicksand": "^5.2.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xmldom/xmldom": "^0.9.8",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
